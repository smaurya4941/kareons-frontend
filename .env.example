# Base URL of the Laravel API (no trailing slash), e.g. http://localhost:8000/api/v1
# Safe to expose to the browser — it's just a base URL, never a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public site URL used for canonical links, sitemap.xml, robots.txt, and
# absolute Open Graph URLs. Must match the domain this Next.js app is served
# from in each environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Name of the httpOnly cookie that stores the Sanctum bearer token.
# Server-only — never read via NEXT_PUBLIC_*.
AUTH_COOKIE_NAME=kareons_token
